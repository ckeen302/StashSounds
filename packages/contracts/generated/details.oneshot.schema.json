{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sampleRate": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "channels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "loudnessLufs": {
      "type": [
        "number",
        "null"
      ]
    },
    "truePeakDb": {
      "type": [
        "number",
        "null"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "808",
        "kick",
        "snare",
        "clap",
        "hat",
        "perc",
        "fx",
        "texture",
        "vocal",
        "bass",
        "other"
      ]
    },
    "rootNote": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        {
          "type": "null"
        }
      ]
    },
    "rootNoteSource": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "filename",
            "pitch_tracking",
            "uploader"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "sampleRate",
    "channels",
    "loudnessLufs",
    "truePeakDb",
    "category",
    "rootNote",
    "rootNoteSource"
  ],
  "additionalProperties": false
}
