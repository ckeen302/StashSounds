{
  "name": "stash",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @stash/web dev",
    "check": "pnpm -r --parallel typecheck && tsc -p tsconfig.json && eslint . --max-warnings 0",
    "test": "vitest run",
    "db:test": "vitest run --config supabase/tests/vitest.config.ts",
    "db:reset": "node scripts/db-reset.mjs",
    "worker:test": "cd apps/worker && uv run --frozen pytest -q",
    "e2e": "playwright test --project=e2e",
    "visual": "node scripts/visual.mjs",
    "visual:update": "node scripts/visual.mjs --update-snapshots=changed",
    "perf": "playwright test --project=perf",
    "licenses": "node scripts/licenses.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@stash/contracts": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "0.25.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "supabase": "3.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
