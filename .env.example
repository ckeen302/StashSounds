# Copy to .env.local. `pnpm dev` fills the Supabase values from `supabase status` automatically.
# Never commit .env.local.

# Supabase (local values come from `npx supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Storage: SeaweedFS (S3 API) locally, Cloudflare R2 in production
STASH_S3_ENDPOINT=http://127.0.0.1:9000
STASH_S3_REGION=auto
STASH_S3_ACCESS_KEY_ID=stash
STASH_S3_SECRET_ACCESS_KEY=stash-local-only
STASH_BUCKET_ORIGINALS=originals
STASH_BUCKET_PREVIEWS=previews
NEXT_PUBLIC_PREVIEWS_BASE_URL=http://127.0.0.1:9000/previews

# Policy tests (pnpm db:test): any Postgres you can create databases on
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
